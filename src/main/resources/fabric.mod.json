  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.unifiedstorage.UnifiedStorageMod"],
    "client": ["dev.unifiedstorage.client.UnifiedStorageClient"]
  },
  "mixins": ["unifiedstorage.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
